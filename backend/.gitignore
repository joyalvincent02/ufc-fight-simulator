# Python environment and bytecode
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.py[cod]
*$py.class

# SQLite database
data/*.db
*.db
*.sqlite
*.sqlite3

# Environment variables (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# But allow .env.example
!.env.example
.env.test.local
.env.production.local

# Machine Learning models and data
# src/ml/fight_predictor.pkl and data/training_dataset.csv ARE intentionally
# tracked - they provide a baseline for first-deploy / fallback if retraining
# fails.  All other large ML artefacts are excluded.
*.joblib
*.h5
*.hdf5
models/
# Exclude experimental / temp models but keep the production one
**/temp_model.*
**/backup_model.*
**/experimental_*.pkl

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# pytest and test caches
.pytest_cache/
.cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Logs
*.log
logs/

# Deployment
deployment/
.azure/
*.publish
*.publishsettings

# OS / IDE / editor specific files
.DS_Store
*.swp
*.swo
*.bak
*.tmp
*.temp
*~

# VSCode settings (optional)
.vscode/

# APScheduler job store
scheduled_jobs

# CI-generated deployment venv (created by GitHub Actions, not for commit)
antenv/

# Playwright browser binaries installed at runtime (not for commit)
.playwright_browsers/
playwright-browsers/
